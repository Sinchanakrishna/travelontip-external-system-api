			<db:sql ><![CDATA[select * from schedules where companyname = 'TravelOnTip';]]></db:sql>
		</db:select>
		<ee:transform doc:name="Transform Message" doc:id="ecb60812-383e-4370-8ec7-1b3c00710d72" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="end logger" doc:id="69ce4c1d-9648-4159-b213-e694b46b5cec" message="response received from DB for travelontip schedules"/>
	</sub-flow>
</mule>
